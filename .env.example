# 복사해서 .env로 저장한 뒤 값을 채운다. .env는 커밋하지 않는다.
# 형식 예시만 적는다. 실제 값은 팀 비밀 관리 위치에서 받는다.

# PostgreSQL (회사 제공 DB) - 예: jdbc:postgresql://<host>:5432/<database>
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# JWT 서명 키: 32바이트 이상 난수의 Base64 (예: openssl rand -base64 48)
JWT_SECRET=

# HTTPS가 아닌 로컬 테스트에서만 false
AUTH_COOKIE_SECURE=true

# 컨테이너 외부로 열 BE 포트 (기본 8080)
BE_PORT=8080

# 최초 기동 시 시스템 관리자가 한 명도 없을 때만 사용. 계정 생성 후에는 비워 둔다.
# 비밀번호는 영문+숫자+특수문자 포함 8자 이상. 첫 로그인 후 변경해야 한다.
INITIAL_ADMIN_LOGIN_ID=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
