        <mxCell id="dom11" value="&lt;b&gt;11. 리포트&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;&lt;i&gt;계획: weekly_reports&lt;/i&gt;&lt;br&gt;&lt;span style='color:#6C8EBF'&gt;users 참조 FK 1개&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;verticalAlign=top;spacing=8;fontFamily=Noto Sans CJK KR;fillColor=#FFFFFF;strokeColor=#82B366;dashed=1;" vertex="1" parent="1">
