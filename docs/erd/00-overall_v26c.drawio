        <mxCell id="dt" value="CoreviaAI 도메인 관계도 (도메인 간 FK 참조)" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontFamily=Noto Sans CJK KR;" vertex="1" parent="1">
