        <mxCell id="dom04" value="&lt;b&gt;04. WBS·일정&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;구현: wbs_tasks, wbs_dependencies, milestones, milestone_tasks&lt;br&gt;&lt;span style='color:#6C8EBF'&gt;users 참조 FK 4개&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;verticalAlign=top;spacing=8;fontFamily=Noto Sans CJK KR;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="1200" y="450" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="dom09" value="&lt;b&gt;09. 지식&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;&lt;i&gt;계획: kb_documents, kb_document_versions, kb_tags, kb_document_tags, glossary_terms, glossary_term_versions, glossary_term_documents, document_chunks&lt;/i&gt;&lt;br&gt;&lt;span style='color:#6C8EBF'&gt;users 참조 FK 4개&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;verticalAlign=top;spacing=8;fontFamily=Noto Sans CJK KR;fillColor=#FFFFFF;strokeColor=#82B366;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="820" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="dom08" value="&lt;b&gt;08. 회의록·산출물·게시판·파일&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;구현: meetings, meeting_attendees, meeting_decisions, action_items, meeting_create_requests&lt;br&gt;&lt;i&gt;계획: board_posts, post_attachments, files, deliverables, deliverable_versions, file_folders&lt;/i&gt;&lt;br&gt;&lt;span style='color:#6C8EBF'&gt;users 참조 FK 8개&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;verticalAlign=top;spacing=8;fontFamily=Noto Sans CJK KR;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="600" y="820" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="dom07" value="&lt;b&gt;07. 이슈&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;&lt;i&gt;계획: issues, issue_status_histories&lt;/i&gt;&lt;br&gt;&lt;span style='color:#6C8EBF'&gt;users 참조 FK 3개&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;verticalAlign=top;spacing=8;fontFamily=Noto Sans CJK KR;fillColor=#FFFFFF;strokeColor=#82B366;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="820" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="dom10" value="&lt;b&gt;10. AI 리스크·AI 초안&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;구현: ai_drafts, risk_analysis_runs, risk_detections&lt;br&gt;&lt;i&gt;계획: project_risk_scores, risk_responses&lt;/i&gt;&lt;br&gt;&lt;span style='color:#6C8EBF'&gt;users 참조 FK 3개&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;verticalAlign=top;spacing=8;fontFamily=Noto Sans CJK KR;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
