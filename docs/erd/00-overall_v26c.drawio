  <diagram id="erd-domains" name="도메인 관계도">
    <mxGraphModel grid="1" gridSize="10" page="0" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dom01" value="&lt;b&gt;01. 사용자·인증&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;구현: users, local_credentials, login_history&lt;br&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;verticalAlign=top;spacing=8;fontFamily=Noto Sans CJK KR;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="0" y="80" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="dom12" value="&lt;b&gt;12. 알림&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;&lt;i&gt;계획: notifications&lt;/i&gt;&lt;br&gt;&lt;span style='color:#6C8EBF'&gt;users 참조 FK 1개&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;verticalAlign=top;spacing=8;fontFamily=Noto Sans CJK KR;fillColor=#FFFFFF;strokeColor=#82B366;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="80" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="dom05" value="&lt;b&gt;05. 업무·보드&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;구현: board_columns, task_histories&lt;br&gt;&lt;i&gt;계획: task_comments, task_mentions&lt;/i&gt;&lt;br&gt;&lt;span style='color:#6C8EBF'&gt;users 참조 FK 3개&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;verticalAlign=top;spacing=8;fontFamily=Noto Sans CJK KR;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="1200" y="80" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="dom06" value="&lt;b&gt;06. 개인 업무&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;구현: personal_todos, personal_events, worklogs, worklog_tasks&lt;br&gt;&lt;i&gt;계획: note_folders, notes, note_links&lt;/i&gt;&lt;br&gt;&lt;span style='color:#6C8EBF'&gt;users 참조 FK 5개&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;verticalAlign=top;spacing=8;fontFamily=Noto Sans CJK KR;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="1800" y="80" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="dom02" value="&lt;b&gt;02. 관리&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;구현: departments, audit_logs, error_logs, code_groups, codes, i18n_labels, menus&lt;br&gt;&lt;i&gt;계획: account_requests, external_account_projects, system_settings&lt;/i&gt;&lt;br&gt;&lt;span style='color:#6C8EBF'&gt;users 참조 FK 4개&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;verticalAlign=top;spacing=8;fontFamily=Noto Sans CJK KR;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="0" y="450" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="dom03" value="&lt;b&gt;03. 프로젝트&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;구현: projects, project_actors, project_members, project_phases, project_member_histories, project_departments, project_features, project_templates, project_setting_histories&lt;br&gt;&lt;i&gt;계획: phase_gate_histories&lt;/i&gt;&lt;br&gt;&lt;span style='color:#6C8EBF'&gt;users 참조 FK 8개&lt;/span&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;verticalAlign=top;spacing=8;fontFamily=Noto Sans CJK KR;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="600" y="450" width="330" height="150" as="geometry" />
