<mxfile host="app.diagrams.net"><diagram id="personal-todos" name="06 Personal TODO supplement"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="users" value="&lt;b&gt;users (global reference)&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK id : BIGINT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="260" height="110" as="geometry" /></mxCell><mxCell id="todos" value="&lt;b&gt;personal_todos (coreviaai_be)&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK id : BIGINT&lt;br&gt;FK user_id : BIGINT NOT NULL&lt;br&gt;title : VARCHAR(200) NOT NULL&lt;br&gt;due_date : DATE NULL&lt;br&gt;done : BOOLEAN NOT NULL DEFAULT FALSE&lt;br&gt;done_at : TIMESTAMPTZ NULL&lt;br&gt;request_id : VARCHAR(36) NOT NULL&lt;br&gt;request_hash : VARCHAR(64) NOT NULL&lt;br&gt;created_at : TIMESTAMPTZ NOT NULL&lt;br&gt;updated_at : TIMESTAMPTZ NOT NULL&lt;br&gt;&lt;br&gt;UK (user_id, request_id)&lt;br&gt;CHECK done / done_at consistency" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="460" y="90" width="430" height="340" as="geometry" /></mxCell><mxCell id="fk" value="1 : N - NO ACTION" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERone;endArrow=ERmany;" edge="1" parent="1" source="users" target="todos"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;DRAFT - SCRUM-111 / FR-PSN-01 / V13&lt;/b&gt;&lt;br&gt;Personal TODO supplement only; does not replace the existing full domain ERD.&lt;br&gt;Assigned tasks are read live from wbs_tasks, not persisted here.&lt;br&gt;Deletion and approval-source integration await a product decision.&lt;br&gt;Deploy V8-V12 first. Do not deploy V13 alone before reserved migrations." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="500" width="840" height="150" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>