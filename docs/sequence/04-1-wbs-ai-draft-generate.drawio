1"><mxGeometry relative="1" as="geometry"><mxPoint x="1720" y="374" as="sourcePoint"/><mxPoint x="800" y="374" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="404 PROJECT_NOT_FOUND / 403 PROJECT_PM_ONLY / 404 PHASES_NOT_AVAILABLE / 404 FEATURE_DISABLED" style="dashed=1;endArrow=open;endFill=0;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="468" as="sourcePoint"/><mxPoint x="110" y="468" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="WbsDraftContext(기간은 null 가능)" style="dashed=1;endArrow=open;endFill=0;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="526" as="sourcePoint"/><mxPoint x="570" y="526" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="generate(context)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="572" as="sourcePoint"/><mxPoint x="1030" y="572" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="generate(AiWbsGenerateRequest) 같은 프로세스 호출" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="618" as="sourcePoint"/><mxPoint x="1260" y="618" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="AiWbsDraftResult (이식 전: 항상 503 AI_NOT_READY)" style="dashed=1;endArrow=open;endFill=0;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="664" as="sourcePoint"/><mxPoint x="1030" y="664" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="도메인 결과로 변환(없는 단계 제안 → 502)" style="endArrow=block;endFill=1;html=1;align=left;spacingLeft=4;fontSize=12;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="710" as="sourcePoint"/><mxPoint x="1030" y="734" as="targetPoint"/><Array as="points"><mxPoint x="1070" y="710"/><mxPoint x="1070" y="734"/></Array></mxGeometry></mxCell><mxCell id="c17" value="503 AI_NOT_READY / 502 AI_GENERATION_FAILED / 504 AI_TIMEOUT" style="dashed=1;endArrow=open;endFill=0;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="822" as="sourcePoint"/><mxPoint x="570" y="822" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="ai_drafts FAILED, 감사 로그 AI_WBS_DRAFT_REQUESTED(outcome=ErrorCode) [각각 별도 트랜잭션]" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="868" as="sourcePoint"/><mxPoint x="1720" y="868" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="같은 오류 (내부 원문 미노출)" style="dashed=1;endArrow=open;endFill=0;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="914" as="sourcePoint"/><mxPoint x="110" y="914" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="WbsDraftProposal" style="dashed=1;endArrow=open;endFill=0;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="972" as="sourcePoint"/><mxPoint x="570" y="972" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="ai_drafts INSERT (WBS_DRAFT, DRAFT, AI 결과 JSON, 응답 시간) [자체 트랜잭션]" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="1018" as="sourcePoint"/><mxPoint x="1720" y="1018" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="issue(draftToken → projectId·userId·aiDraftId, TTL 1h)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="1064" as="sourcePoint"/><mxPoint x="1490" y="1064" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="감사 로그 AI_WBS_DRAFT_REQUESTED(SUCCESS, 개수) [별도 트랜잭션]" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="1110" as="sourcePoint"/><mxPoint x="1720" y="1110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="GeneratedWbsDraft" style="dashed=1;endArrow=open;endFill=0;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="1156" as="sourcePoint"/><mxPoint x="340" y="1156" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="200 {status: AI_DRAFT, draftToken, expiresAt, stages, milestones, ...}" style="dashed=1;endArrow=open;endFill=0;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="1202" as="sourcePoint"/><mxPoint x="110" y="1202" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="WBS 테이블은 바꾸지 않음(NFR-08). AI 결과는 ai_drafts에 기록, FE는 승인 항목만 04-2로 보냄&lt;br&gt;DB 트랜잭션 밖에서 AI를 호출해 LLM 대기 중 커넥션을 잡지 않음. LLM 호출은 aiserver만" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=8;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="22" y="1248" width="866" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
