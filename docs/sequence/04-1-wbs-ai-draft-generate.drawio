<mxfile host="CoreviaAI"><diagram id="seq" name="04-1. AI WBS 초안 생성 (POST /api/projects/{projectId}/wbs/ai-draft)"><mxGraphModel grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="04-1. AI WBS 초안 생성 (POST /api/projects/{projectId}/wbs/ai-draft)" style="text;html=1;fontSize=17;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="12" y="8" width="1828" height="30" as="geometry"/></mxCell><mxCell id="c1" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=46;height=20;fillColor=none;strokeColor=#7A869A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="18" y="420" width="874" height="62" as="geometry"/></mxCell><mxCell id="c2" value="판정 실패 (AI 호출 전, 감사 로그 없음)" style="text;html=1;align=left;verticalAlign=middle;fontColor=#42526E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="68" y="421" width="820" height="20" as="geometry"/></mxCell><mxCell id="c3" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=46;height=20;fillColor=none;strokeColor=#7A869A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="18" y="774" width="1794" height="154" as="geometry"/></mxCell><mxCell id="c4" value="AI 실패" style="text;html=1;align=left;verticalAlign=middle;fontColor=#42526E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="68" y="775" width="1740" height="20" as="geometry"/></mxCell><mxCell id="p_fe" value="FE&lt;br&gt;PM 브라우저" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fillColor=#F4F5F7;strokeColor=#6B778C;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="12.0" y="50" width="196" height="1282" as="geometry"/></mxCell><mxCell id="p_ctl" value="WbsAiDraftController&lt;br&gt;coreviaai_be" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fillColor=#E3FCEF;strokeColor=#57A55A;fontStyle=1;" vertex="1" parent