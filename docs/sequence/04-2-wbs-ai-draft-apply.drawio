 y="756" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="ROLLBACK (WBS 저장 없음, ai_drafts는 DRAFT 유지)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="850" as="sourcePoint"/><mxPoint x="1490" y="850" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="issue(token) 되돌림 → 고친 뒤 같은 토큰으로 재반영" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="896" as="sourcePoint"/><mxPoint x="1260" y="896" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="400 INVALID_WBS_DRAFT_* / WBS_DEPENDENCY_CYCLE / INVALID_TASK_ASSIGNEE ..." style="dashed=1;endArrow=open;endFill=0;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="942" as="sourcePoint"/><mxPoint x="110" y="942" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="COMMIT" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="1000" as="sourcePoint"/><mxPoint x="1490" y="1000" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="markApplied(token) (실패해도 응답 성공, 로그만)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="1046" as="sourcePoint"/><mxPoint x="1260" y="1046" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="AppliedWbsDraft" style="dashed=1;endArrow=open;endFill=0;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="1092" as="sourcePoint"/><mxPoint x="340" y="1092" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="200 {taskIds: {tempId: id}, milestoneIds: {tempId: id}}" style="dashed=1;endArrow=open;endFill=0;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="1138" as="sourcePoint"/><mxPoint x="110" y="1138" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="단계(project_phases)와 연결하지 않음(ERD 04). 프로젝트 기간이 없으면 기간 경계 검사를 생략&lt;br&gt;토큰은 프로젝트·PM에 묶이고 1회만 사용. 저장 전 서버가 전부 다시 검증(FE·AI 값 불신)" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=8;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="22" y="1184" width="1096" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
