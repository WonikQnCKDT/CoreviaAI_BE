<mxfile host="CoreviaAI"><diagram id="seq" name="04-3. WBS 항목 이동 (PUT /api/projects/{projectId}/wbs/tasks/{taskId}/position)"><mxGraphModel grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="04-3. WBS 항목 이동 (PUT /api/projects/{projectId}/wbs/tasks/{taskId}/position)" style="text;html=1;fontSize=17;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="12" y="8" width="1240" height="30" as="geometry"/></mxCell><mxCell id="p_fe" value="FE&lt;br&gt;PM 브라우저" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fillColor=#F4F5F7;strokeColor=#6B778C;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="12" y="50" width="220" height="978" as="geometry"/></mxCell><mxCell id="p_ctl" value="WbsTaskController&lt;br&gt;coreviaai_be" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fillColor=#E3FCEF;strokeColor=#57A55A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="262" y="50" width="220" height="978" as="geometry"/></mxCell><mxCell id="p_svc" value="WbsTaskService&lt;br&gt;coreviaai_be" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fillColor=#E3FCEF;strokeColor=#57A55A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="512" y="50" width="220" height="978" as="geometry"/></mxCell><mxCell id="p_pol" value="WbsTaskAccessPolicy·WbsEditor&lt;br&gt;coreviaai_be" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fillColor=#E3FCEF;strokeColor=#57A55A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="762" y="50" width="220" height="978" as="geometry"/></mxCell><mxCell id="p_db" value="PostgreSQL&lt;br&gt;projects·project_members·wbs_tasks" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1012" y="50" width="220" height="978" as="geometry"/></mxCell><mxCell id="m0" value="PUT position {parentTaskId, index, version}" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="122" y="140" as="sourcePoint"/><mxPoint x="372" y="140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m1" value="요청 검증(index 0~2000, version ≥ 0) → 400" style="endArrow=block;endFill=1;html=1;align=left;spacingLeft=4;fontSize=12;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="372" y="186" as="sourcePoint"/><mxPoint x="372" y="210" as="targetPoint"/><Array as="points"><mxPoint x="402" y="186"/><mxPoint x="402" y="210"/></Array></mxGeometry></mxCell><mxCell id="m2" value="move(actor, projectId, taskId, command) [트랜잭션 시작]" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="372" y="232" as="sourcePoint"/><mxPoint x="622" y="232" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m3" value="getEditor(userId, projectId)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="622" y="278" as="sourcePoint"/><mxPoint x="872" y="278" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m4" value="공개 범위 확인 → 없으면 404 PROJECT_NOT_FOUND, WBS 기능 확인 → 404 FEATURE_DISABLED" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="872" y="324" as="sourcePoint"/><mxPoint x="1122" y="324" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m5" value="SELECT projects ... FOR UPDATE (프로젝트 행 잠금: 같은 프로젝트 WBS 변경 직렬화)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="872" y="370" as="sourcePoint"/><mxPoint x="1122" y="370" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m6" value="WbsEditor(역할) — PM 아니면 403 PROJECT_PM_ONLY" style="dashed=1;endArrow=open;endFill=0;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="872" y="416" as="sourcePoint"/><mxPoint x="622" y="416" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m7" value="옮길 항목·새 상위 작업 조회(프로젝트 ID 조건) → 없으면 404 WBS_TASK_NOT_FOUND" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="622" y="462" as="sourcePoint"/><mxPoint x="1122" y="462" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m8" value="계층 검사: 새 부모가 하위작업·자기 자신, 하위작업 가진 작업을 하위로 → 400 INVALID_WBS_HIERARCHY" style="endArrow=block;endFill=1;html=1;align=left;spacingLeft=4;fontSize=12;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="622" y="508" as="sourcePoint"/><mxPoint x="622" y="532" as="targetPoint"/><Array as="points"><mxPoint x="652" y="508"/><mxPoint x="652" y="532"/></Array></mxGeometry></mxCell><mxCell id="m9" value="새 부모의 형제 목록(sort_order, id 순)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="622" y="554" as="sourcePoint"/><mxPoint x="1122" y="554" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m10" value="index &gt; 형제 수 → 400 INVALID_WBS_POSITION / 같은 위치면 변경 없이 200(멱등)" style="endArrow=block;endFill=1;html=1;align=left;spacingLeft=4;fontSize=12;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="622" y="600" as="sourcePoint"/><mxPoint x="622" y="624" as="targetPoint"/><Array as="points"><mxPoint x="652" y="600"/><mxPoint x="652" y="624"/></Array></mxGeometry></mxCell><mxCell id="m11" value="version 불일치 → 409 CONCURRENT_MODIFICATION" style="endArrow=block;endFill=1;html=1;align=left;spacingLeft=4;fontSize=12;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="622" y="646" as="sourcePoint"/><mxPoint x="622" y="670" as="targetPoint"/><Array as="points"><mxPoint x="652" y="646"/><mxPoint x="652" y="670"/></Array></mxGeometry></mxCell><mxCell id="m12" value="UPDATE 옮긴 항목 parent_task_id·sort_order (version +1)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="622" y="692" as="sourcePoint"/><mxPoint x="1122" y="692" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m13" value="부모가 바뀌면: 옛·새 상위 작업 기간 = 하위작업 min(start)~max(end) (version +1)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="622" y="738" as="sourcePoint"/><mxPoint x="1122" y="738" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m14" value="형제 순서 1부터 재정렬: UPDATE sort_order만 (version 유지, 바뀐 행만)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="622" y="784" as="sourcePoint"/><mxPoint x="1122" y="784" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m15" value="트리 다시 조회(항목 전체 1회 + 담당자 이름 1회)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="622" y="830" as="sourcePoint"/><mxPoint x="1122" y="830" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m16" value="WbsTaskChange(taskId, 트리) [커밋·잠금 해제]" style="dashed=1;endArrow=open;endFill=0;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="622" y="876" as="sourcePoint"/><mxPoint x="372" y="876" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m17" value="200 {taskId, tasks[]} — 화면은 이 트리로 다시 그림" style="dashed=1;endArrow=open;endFill=0;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="372" y="922" as="sourcePoint"/><mxPoint x="122" y="922" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
