<mxfile host="CoreviaAI"><diagram id="seq" name="05-1. 칸반 카드 이동 (PUT /api/projects/{projectId}/board/cards/{taskId}/column)"><mxGraphModel grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="05-1. 칸반 카드 이동 (PUT /api/projects/{projectId}/board/cards/{taskId}/column)" style="text;html=1;fontSize=17;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="12" y="8" width="1500" height="30" as="geometry"/></mxCell><mxCell id="p_fe" value="FE&lt;br&gt;담당자·PM 브라우저" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fillColor=#F4F5F7;strokeColor=#6B778C;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="12" y="50" width="220" height="1070" as="geometry"/></mxCell><mxCell id="p_ctl" value="BoardController&lt;br&gt;coreviaai_be" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fillColor=#E3FCEF;strokeColor=#57A55A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="262" y="50" width="220" height="1070" as="geometry"/></mxCell><mxCell id="p_svc" value="BoardService&lt;br&gt;coreviaai_be" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fillColor=#E3FCEF;strokeColor=#57A55A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="512" y="50" width="220" height="1070" as="geometry"/></mxCell><mxCell id="p_pol" value="WbsTaskAccessPolicy·WbsEditor&lt;br&gt;coreviaai_be" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fillColor=#E3FCEF;strokeColor=#57A55A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="762" y="50" width="220" height="1070" as="geometry"/></mxCell><mxCell id="p_dom" value="WbsTask·TaskHistoryRecorder&lt;br&gt;coreviaai_be" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fillColor=#E3FCEF;strokeColor=#57A55A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1012" y="50" width="220" height="1070" as="geometry"/></mxCell><mxCell id="p_db" value="PostgreSQL&lt;br&gt;projects·wbs_tasks·board_columns·task_histories" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=46;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1262" y="50" width="220" height="1070" as="geometry"/></mxCell><mxCell id="m0" value="PUT column {columnId, version} (카드 드래그)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="122" y="140" as="sourcePoint"/><mxPoint x="372" y="140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m1" value="요청 검증(columnId 양수 필수, version ≥ 0) → 400" style="endArrow=block;endFill=1;html=1;align=left;spacingLeft=4;fontSize=12;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="372" y="186" as="sourcePoint"/><mxPoint x="372" y="210" as="targetPoint"/><Array as="points"><mxPoint x="402" y="186"/><mxPoint x="402" y="210"/></Array></mxGeometry></mxCell><mxCell id="m2" value="moveCard(actor, projectId, taskId, command) [트랜잭션 시작]" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="372" y="232" as="sourcePoint"/><mxPoint x="622" y="232" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m3" value="getEditor(userId, projectId, KANBAN)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="622" y="278" as="sourcePoint"/><mxPoint x="872" y="278" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m4" value="공개 범위 → 404 PROJECT_NOT_FOUND, KANBAN 모듈 꺼짐 → 404 FEATURE_DISABLED" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="872" y="324" as="sourcePoint"/><mxPoint x="1372" y="324" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m5" value="SELECT projects ... FOR UPDATE (WBS 변경·컬럼 관리·작업 등록과 직렬화)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="872" y="370" as="sourcePoint"/><mxPoint x="1372" y="370" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m6" value="WbsEditor(프로젝트 역할)" style="dashed=1;endArrow=open;endFill=0;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="872" y="416" as="sourcePoint"/><mxPoint x="622" y="416" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m7" value="업무 조회(프로젝트 ID 조건) → 없으면 404 WBS_TASK_NOT_FOUND" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="622" y="462" as="sourcePoint"/><mxPoint x="1372" y="462" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m8" value="requireCanUpdate(task): PM 전체, 개발자·QA 본인 담당만, 그 외 403 WBS_TASK_ASSIGNEE_ONLY" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="622" y="508" as="sourcePoint"/><mxPoint x="872" y="508" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m9" value="대상 컬럼 조회(프로젝트 ID 조건) → 없으면 404 BOARD_COLUMN_NOT_FOUND" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="622" y="554" as="sourcePoint"/><mxPoint x="1372" y="554" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m10" value="같은 컬럼이면 변경 없이 WIP 판정으로(멱등) / version 다르면 409 CONCURRENT_MODIFICATION" style="endArrow=block;endFill=1;html=1;align=left;spacingLeft=4;fontSize=12;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="622" y="600" as="sourcePoint"/><mxPoint x="622" y="624" as="targetPoint"/><Array as="points"><mxPoint x="652" y="600"/><mxPoint x="652" y="624"/></Array></mxGeometry></mxCell><mxCell id="m11" value="before = TaskSnapshot.of(task); task.moveToColumn(column, clock.instant())" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="622" y="646" as="sourcePoint"/><mxPoint x="1122" y="646" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m12" value="board_column_id ← 컬럼. 상태가 바뀔 때만 status·status_changed_at, DONE이면 completed_at·progress 100, DONE 이탈 시 completed_at NULL" style="endArrow=block;endFill=1;html=1;align=left;spacingLeft=4;fontSize=12;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1122" y="692" as="sourcePoint"/><mxPoint x="1122" y="716" as="targetPoint"/><Array as="points"><mxPoint x="1152" y="692"/><mxPoint x="1152" y="716"/></Array></mxGeometry></mxCell><mxCell id="m13" value="flush: UPDATE wbs_tasks ... WHERE version = ? (version + 1)" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="622" y="738" as="sourcePoint"/><mxPoint x="1372" y="738" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m14" value="historyRecorder.changed(actor, before, after) [MANDATORY]" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="622" y="784" as="sourcePoint"/><mxPoint x="1122" y="784" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m15" value="INSERT task_histories: STATUS_CHANGED{status, boardColumnId} 또는 BOARD_COLUMN_CHANGED, PROGRESS_CHANGED" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1122" y="830" as="sourcePoint"/><mxPoint x="1372" y="830" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m16" value="보드 배치 읽기(컬럼 1회 + 업무 1회) → 대상 컬럼 카드 수" style="endArrow=block;endFill=1;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="622" y="876" as="sourcePoint"/><mxPoint x="1372" y="876" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m17" value="WIP 판정: 카드 수 &gt; wip_limit 이면 경고(이동은 반영됨, 차단 안 함)" style="endArrow=block;endFill=1;html=1;align=left;spacingLeft=4;fontSize=12;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="622" y="922" as="sourcePoint"/><mxPoint x="622" y="946" as="targetPoint"/><Array as="points"><mxPoint x="652" y="922"/><mxPoint x="652" y="946"/></Array></mxGeometry></mxCell><mxCell id="m18" value="BoardCardMove [커밋 — 4xx·오류면 상태·이력 함께 롤백]" style="dashed=1;endArrow=open;endFill=0;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="622" y="968" as="sourcePoint"/><mxPoint x="372" y="968" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m19" value="200 {card(새 version), column{cardCount, wipLimit, wipExceeded}, wipWarning}" style="dashed=1;endArrow=open;endFill=0;html=1;verticalAlign=bottom;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="372" y="1014" as="sourcePoint"/><mxPoint x="122" y="1014" as="targetPoint"/></mxGeometry></mxCell><mxCell id="note" value="권한(3.3 TSK-02): PM 전체 이동, 개발자·QA 본인 카드, 현업 담당자·경영진·비멤버 조회만. 판정 순서: 프로젝트 404 → 기능 404 → 업무 404 → 담당 403 → 컬럼 404 → 같은 컬럼 200(멱등) → version 409. 상태 = 컬럼 status_category(TASK_STATUS 코드)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFAE6;strokeColor=#FFAB00;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="12" y="1130" width="1470" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
